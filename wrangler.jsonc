{
  "name": "cafe-principe",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/prato/*"]
  },
  // necessário para as pré-visualizações dos pull requests (npx wrangler preview); pode ficar vazio
  "previews": {}
}
